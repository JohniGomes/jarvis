# Copie este arquivo pra ".env" (na raiz do repo) e preencha os valores.
# O ".env" real NUNCA é commitado (já está no .gitignore) e o valor de cada
# variável nunca deve ser colado no chat -- preencha direto no arquivo.

# Login do sistema.entregoaguasclaras.com.br (robo "Sem Corridas")
SISTEMA_EMAIL=
SISTEMA_PASSWORD=

# Login do franqueado.entregolog.com (robo "D-1")
FRANQUEADO_EMAIL=
FRANQUEADO_PASSWORD=

# Senha da caixa de e-mail (IMAP/Titan) que recebe o código de acesso do
# franqueado.entregolog.com -- pode ser diferente da senha do site acima,
# mesmo sendo o mesmo endereço de e-mail.
EMAIL_IMAP_PASSWORD=

# Supabase (Project Settings > API no painel do Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chatwoot (Perfil > Token de acesso) -- gere um token novo, o antigo foi
# exposto no chat numa conversa anterior e deve ser considerado comprometido
CHATWOOT_TOKEN=

# Gemini API (aistudio.google.com/apikey) -- classificação de mensagens
# do Chatwoot e resumo com IA (trocado de Claude em 20/08/2026, tier
# gratuito sem cartão)
GEMINI_API_KEY=

# Proxy residencial (IPRoyal Static Residential/ISP, Brasil) -- necessário
# pra robôs que acessam franqueado.entregolog.com fora da máquina local
# (o site bloqueia IP de nuvem/datacenter). Ver robots/browser_launch.py.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
